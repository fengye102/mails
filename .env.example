# Replace every placeholder; keep this file private after copying to .env.
POSTGRES_DB=mails
POSTGRES_USER=mails
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
MAILS_DATABASE_URL=postgresql+psycopg://mails:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/mails
