# C 阶段独立部署配置；不要与 A/B1 的 .env 混用
DELIVERY_POSTGRES_DB=delivery
DELIVERY_POSTGRES_USER=delivery
DELIVERY_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DELIVERY_DATABASE_URL=postgresql+psycopg://delivery:REPLACE_WITH_RANDOM_PASSWORD@delivery-db:5432/delivery
DELIVERY_OPERATOR_TOKEN=REPLACE_WITH_HIGH_ENTROPY_OPERATOR_TOKEN
DELIVERY_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
# 取件页对外基址，例如 https://delivery.example.com；留空则签发出相对路径
DELIVERY_PICKUP_BASE_URL=
DELIVERY_PICKUP_TTL_SECONDS=900
DELIVERY_SESSION_TTL_SECONDS=1800
DELIVERY_PICKUP_FAILURE_LIMIT=5
DELIVERY_PICKUP_FAILURE_WINDOW_SECONDS=300
DELIVERY_PICKUP_BACKOFF_SECONDS=300
DELIVERY_CLEANUP_INTERVAL_SECONDS=60
DELIVERY_DOMAIN=delivery.example.com
DELIVERY_HTTPS_PORT=443
