# B1 public service configuration; keep separate from A private credentials.
PUBLIC_MAIL_POSTGRES_DB=public_mail
PUBLIC_MAIL_POSTGRES_USER=public_mail
PUBLIC_MAIL_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
PUBLIC_MAIL_DATABASE_URL=postgresql+psycopg://public_mail:REPLACE_WITH_RANDOM_HEX_PASSWORD@public-db:5432/public_mail
PUBLIC_MAIL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
PUBLIC_MAIL_PUBLIC_ORIGIN=https://temp.example.com
PUBLIC_MAIL_DOMAIN=temp.example.com
PUBLIC_MAIL_UPSTREAM_URL=https://cloudflare-worker.example.com
PUBLIC_MAIL_ADMIN_KEY=REPLACE_WITH_CLOUDFLARE_ADMIN_KEY
PUBLIC_MAIL_ALLOWED_ORIGINS=["https://temp.example.com"]
PUBLIC_MAIL_COOKIE_SECURE=true
PUBLIC_MAIL_TTL_SECONDS=86400
PUBLIC_MAIL_TURNSTILE_SECRET=
PUBLIC_MAIL_CAPABILITY_COOKIE_NAME=public_mail_capability
# Set to 443 on a dedicated public host; use 8443 only for a shared dev host.
PUBLIC_MAIL_HTTPS_PORT=443
